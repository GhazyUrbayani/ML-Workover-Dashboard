{
  "version": 2,
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "workover_model_pipeline.joblib,preprocessor.joblib,dashboard_data.json"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/dashboard_data.json",
      "dest": "/dashboard_data.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
