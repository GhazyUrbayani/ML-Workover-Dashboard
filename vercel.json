{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "workover_model_pipeline.joblib,preprocessor.joblib,dashboard_data.json,lib/**,api/lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?path=/api/$1"
    }
  ]
}
